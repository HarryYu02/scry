# --- Go ---
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# --- Python ---
# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/

# Tooling caches (Linting, Formatting, Typing)
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Distribution / Packaging
build/
dist/
*.egg-info/
